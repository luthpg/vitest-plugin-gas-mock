         *     var people = document.getRootElement().getChildren('person');
         *     for (var i = 0; i < people.length; i++) {
         *       var person = people[i];
         *       var firstName = person.getAttribute('first').getValue();
         *       var lastName = person.getAttribute('last').getValue();
